<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top bar: only what is needed while labeling. Settings, files, training and export are behind the menu button. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/passIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/pass1_title"
            android:textColor="#1565C0"
            android:textSize="13sp" />

        <!-- Pass 1 tools (Saccade, Blink, Eraser) -->
        <LinearLayout
            android:id="@+id/toolGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saccadeToolBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/tool_saccade"
                android:textSize="12sp" />

            <Button
                android:id="@+id/blinkToolBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/tool_blink"
                android:textSize="12sp" />

            <Button
                android:id="@+id/eraserToolBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/tool_eraser"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Pass 2 event badge -->
        <TextView
            android:id="@+id/eventCounterBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="#37474F"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/undoBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="3dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/undo"
            android:textSize="12sp" />

        <Button
            android:id="@+id/switchPassBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="3dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/switch_pass"
            android:textSize="12sp" />

        <Button
            android:id="@+id/menuBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="3dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="☰"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Settings panel, hidden by default so that the traces get the screen -->
    <HorizontalScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <EditText
                android:id="@+id/winMsEdit"
                android:layout_width="96dp"
                android:layout_height="44dp"
                android:hint="@string/window_ms_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textAlignment="center"
                android:textSize="13sp" />

            <Button
                android:id="@+id/filterBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="@string/filter_btn"
                android:textSize="12sp" />

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="@string/save"
                android:textSize="12sp" />

            <Button
                android:id="@+id/trainNowBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="@string/train_now"
                android:textSize="12sp" />

            <Button
                android:id="@+id/metricsBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="@string/metrics"
                android:textSize="12sp" />

            <Button
                android:id="@+id/exportBtn"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="@string/export"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main canvas view -->
    <com.uneye.offline.TraceView
        android:id="@+id/traceView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- One status line: marks / reviewed time, training state, convergence flag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#455A64"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/trainStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/training_idle"
            android:textColor="#546E7A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/convergenceBadge"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Contextual controls for pass 1 (navigation by window and trial) -->
    <LinearLayout
        android:id="@+id/pass1Controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/prevTrialBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/prev_trial"
            android:textSize="13sp" />

        <Button
            android:id="@+id/prevEpochBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/prev_epoch"
            android:textSize="13sp" />

        <Button
            android:id="@+id/nextEpochBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="2"
            android:text="@string/next_epoch"
            android:textSize="13sp" />

        <Button
            android:id="@+id/nextTrialBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/next_trial"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Contextual controls for pass 2 (event by event, across trials) -->
    <LinearLayout
        android:id="@+id/pass2Controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/prevEventBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="◀ Prev"
            android:textSize="13sp" />

        <Button
            android:id="@+id/acceptPreBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="2"
            android:text="@string/accept_prelabel"
            android:textSize="13sp" />

        <Button
            android:id="@+id/notEventBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1.5"
            android:text="@string/not_an_event"
            android:textSize="13sp" />

        <Button
            android:id="@+id/widerBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1.2"
            android:text="@string/wider"
            android:textSize="13sp" />

        <Button
            android:id="@+id/nextEventBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Next ▶"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
